{
  "$schema": "node_modules/wrangler/config-schema.json",
  "name": "goodmusic",
  // Routes /api, /health and /swagger to the API container and everything
  // else to the Next.js app (built into web/.open-next by `npm run build`).
  "main": "worker/index.ts",
  "compatibility_date": "2026-09-01",
  // Next.js on Workers (OpenNext) needs the Node.js compatibility layer.
  "compatibility_flags": ["nodejs_compat", "global_fetch_strictly_public"],
  "assets": {
    "directory": "./web/.open-next/assets",
    "binding": "ASSETS"
  },
  "services": [
    // OpenNext calls back into its own Worker for some internal requests.
    { "binding": "WORKER_SELF_REFERENCE", "service": "goodmusic" }
  ],
  "containers": [
    {
      "class_name": "GoodMusicApi",
      "image": "./Dockerfile",
      // The Dockerfile builds several projects, so the context is the repo root.
      "image_build_context": ".",
      "max_instances": 1,
      "instance_type": "basic"
    }
  ],
  "durable_objects": {
    "bindings": [{ "name": "API", "class_name": "GoodMusicApi" }]
  },
  "migrations": [{ "tag": "v1", "new_sqlite_classes": ["GoodMusicApi"] }],
  "observability": { "enabled": true }
}
